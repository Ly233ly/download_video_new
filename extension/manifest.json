{
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "留底浏览器扩展",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "description": "免费开源的 Windows 本机媒体下载与归档工具",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "留底浏览器扩展",
  "homepage_url": "https://github.com/Ly233ly/download_video_new",
  "key": "",
  "permissions": [
    "tabs",
    "webRequest",
    "storage",
    "webNavigation",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "commands": {
    "_execute_action": {}
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/eagle-bridge-candidate-logic.js",
        "js/content-script.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "version": "2.0.0",
  "incognito": "split"
}
