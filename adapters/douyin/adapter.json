{
  "id": "douyin",
  "name": "抖音",
  "version": 1,
  "updatedFor": null,
  "match": {
    "hosts": ["douyin.com", "*.douyin.com"],
    "priority": 100
  },
  "identity": {
    "urlRules": [
      { "path": "^/video/(\\d{10,30})/?$", "id": "$1" },
      { "query": "modal_id", "pattern": "^\\d{10,30}$", "id": "$0" }
    ],
    "domSignals": ["[data-aweme-id]", "[data-video-id]"],
    "canonical": "https://www.douyin.com/video/{id}",
    "requireId": true
  },
  "capture": {
    "containers": [
      "[data-e2e=\"feed-item\"]",
      "[data-e2e=\"feed-active-video\"]",
      "[data-e2e=\"feed-video\"]",
      "[class*=\"video_\"]"
    ],
    "primarySelection": "current-player",
    "allowDirectStream": true,
    "requireBlobSource": false
  },
  "title": {
    "template": "{nickname} - {description}",
    "fallback": "抖音视频 {id}"
  },
  "resolve": {
    "engine": "yt-dlp",
    "requiresFreshCookies": true,
    "canonicalizePageUrl": true
  },
  "errors": [
    {
      "match": "Unsupported URL",
      "code": "douyin_page_unsupported",
      "message": "抖音内容页不是受支持的视频详情地址，请刷新当前视频后重试"
    },
    {
      "match": "Fresh cookies",
      "code": "douyin_session_expired",
      "message": "抖音需要当前浏览器的新鲜会话，请刷新抖音页面后重试"
    }
  ],
  "codeReason": "需要读取实时播放状态，在页面多个 <video> 中选出主播放器，无法用声明表达。"
}
